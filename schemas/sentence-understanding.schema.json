{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed Sentence Understanding Supplement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "records"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "revision": { "type": "integer", "minimum": 1 },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "understanding": {
      "type": "object",
      "required": ["english", "chinese", "intent", "parts", "notes", "structures", "words", "analysisSource", "analysisStatus", "ruleVersion"],
      "properties": {
        "comparison": { "type": ["object", "null"], "required": ["chinese", "english"], "properties": { "chinese": { "$ref": "#/$defs/text" }, "english": { "$ref": "#/$defs/text" }, "takeaway": { "$ref": "#/$defs/text" }, "steps": { "type": "array", "items": { "type": "object", "required": ["label", "text", "explanation"], "properties": { "label": { "$ref": "#/$defs/text" }, "text": { "$ref": "#/$defs/text" }, "explanation": { "$ref": "#/$defs/text" } } } } } },
        "backbone": { "type": "object", "required": ["text", "meaning"], "properties": { "text": { "$ref": "#/$defs/text" }, "meaning": { "$ref": "#/$defs/text" } } },
        "structureNotes": { "type": "array", "items": { "type": "object", "required": ["title", "text"], "properties": { "title": { "$ref": "#/$defs/text" }, "text": { "$ref": "#/$defs/text" } } } },
        "english": { "$ref": "#/$defs/text" }, "chinese": { "$ref": "#/$defs/text" }, "intent": { "$ref": "#/$defs/text" },
        "analysisSource": { "enum": ["ai", "human"] }, "analysisStatus": { "enum": ["generated", "reviewed", "approved"] },
        "ruleVersion": { "$ref": "#/$defs/text" }, "reviewNote": { "type": ["string", "null"] },
        "parts": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["text", "meaning", "relation"], "properties": { "text": { "$ref": "#/$defs/text" }, "meaning": { "$ref": "#/$defs/text" }, "relation": { "$ref": "#/$defs/text" } } } },
        "notes": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["title", "text"], "properties": { "title": { "$ref": "#/$defs/text" }, "text": { "$ref": "#/$defs/text" } } } },
        "structures": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["text", "role", "explanation"], "properties": { "text": { "$ref": "#/$defs/text" }, "role": { "$ref": "#/$defs/text" }, "explanation": { "$ref": "#/$defs/text" } } } },
        "words": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["text", "meaning", "pos", "phonetic"], "properties": { "text": { "$ref": "#/$defs/text" }, "meaning": { "$ref": "#/$defs/text" }, "pos": { "$ref": "#/$defs/text" }, "phonetic": { "$ref": "#/$defs/text" } } } }
      }
    },
    "record": {
      "allOf": [{ "$ref": "#/$defs/understanding" }],
      "required": ["courseId", "lessonId", "sentenceId", "sentenceOrder"],
      "properties": { "courseId": { "$ref": "#/$defs/text" }, "lessonId": { "$ref": "#/$defs/text" }, "sentenceId": { "$ref": "#/$defs/text" }, "sentenceOrder": { "type": "integer", "minimum": 1 }, "lesson": { "type": "string" } }
    }
  }
}
